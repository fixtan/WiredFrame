{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "sub-monitor-*"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-available-monitors",
    "core:window:allow-create",
    "core:event:default"
  ]
}
